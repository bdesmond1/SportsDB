<%- include('../partials/header', { title }) %>

<div class="container mt-5">
  <h1 class="mb-4"><%= title %></h1>

  <% 
  /* -------------------- DATE FORMATTER -------------------- */
  function formatDate(value) {
    if (!value) return 'None';
    const d = new Date(value);
    if (isNaN(d.getTime())) return value; // fallback
    return d.toLocaleDateString('en-US');
  }

  /* -------------------- TIME FORMATTER -------------------- */
  function formatTime(value) {
    if (!value) return 'None';

    let timeString = value;

    // If MySQL returned "HH:MM", add seconds → "HH:MM:00"
    if (/^\d{2}:\d{2}$/.test(value)) {
      timeString = value + ":00";
    }

    // Build valid ISO datetime
    const t = new Date(`1970-01-01T${timeString}`);

    // If still invalid, return raw value
    if (isNaN(t.getTime())) return value;

    return t.toLocaleTimeString('en-US', {
      hour: 'numeric',
      minute: '2-digit'
    });
  }

  /* -------------------- AUTO FORMATTER -------------------- */
  function formatValue(key, value) {
    if (value === null || value === '') return 'None';

    const lower = key.toLowerCase();

    if (lower.includes('date')) return formatDate(value);
    if (lower.includes('time')) return formatTime(value);

    return value;
  }
  %>

  <% if (!results || results.length === 0) { %>
    <p>No results found.</p>

  <% } else { %>
    <table class="table table-striped table-bordered">
      <thead class="table-dark">
        <tr>
          <% Object.keys(results[0]).forEach(key => { %>
            <th>
              <%= key
                .replace(/_/g, ' ')
                .replace(/([a-z])([A-Z])/g, '$1 $2')
                .replace(/^./, c => c.toUpperCase()) %>
            </th>
          <% }) %>
        </tr>
      </thead>

      <tbody>
        <% results.forEach(row => { %>
          <tr>
            <% Object.keys(row).forEach(key => { %>
              <td><%= formatValue(key, row[key]) %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <div class="mt-3">
    <a href="/sportsArea/dashboard" class="btn btn-secondary">Back to Dashboard</a>
  </div>
</div>

<%- include('../partials/footer') %>
