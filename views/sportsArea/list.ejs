<%- include('../partials/header', { title: 'Sports Areas' }) %>

<div class="container mt-5">
  <a href="/" class="btn btn-secondary mb-3">← Back to Home</a>

  <h2 class="mb-3">Sports Areas</h2>
  <a href="/sportsArea/add" class="btn btn-primary mb-3">Add Sports Area</a>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>Area Name</th>
        <th>Type</th>
        <th>Location</th>
        <th>Capacity</th>
        <th>Open Hours</th>
        <th>Close Hours</th>
        <th>Rec Hours</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% areas.forEach(area => { %>
        <tr>
          <td><%= area.AreaName %></td>
          <td><%= area.Type %></td>
          <td><%= area.Location %></td>
          <td><%= area.Capacity %></td>
          <td>
            <%= new Date('1970-01-01T' + area.OpenTime).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %>
          </td>
          <td>
            <%= new Date('1970-01-01T' + area.CloseTime).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %>
          </td>
          <td>
            <%= new Date('1970-01-01T' + area.RecStartTime).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %> -
            <%= new Date('1970-01-01T' + area.RecEndTime).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %>
          </td>
          <td>
            <a href="/sportsArea/edit/<%= encodeURIComponent(area.AreaName) %>" class="btn btn-sm btn-warning">Edit</a>
            <form action="/sportsArea/delete/<%= encodeURIComponent(area.AreaName) %>" method="POST" style="display:inline">
              <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this sports area?');">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
