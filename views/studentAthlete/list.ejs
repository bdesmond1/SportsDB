<%- include("../partials/header") %>

<div class="container mt-5">
  <a href="/studentAthlete/dashboard" class="btn btn-secondary mb-3">← Back to Dashboard</a>
  <h2><%= title %></h2>

  <a href="/studentAthlete/add" class="btn btn-primary mb-3">Add Student Athlete</a>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>DOB</th>
        <th>Status</th>
        <th>Teams</th>
        <th>Medical History</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% studentAthletes.forEach(a => { %>
        <tr>
          <td><%= a.StudentID %></td>
          <td><%= a.Name %></td>
          <td><%= a.DOB.toISOString().split('T')[0] %></td>
          <td>
            <span class="badge bg-<%= 
              a.Status === 'Active' ? 'success' : 
              a.Status === 'Injured' ? 'warning' : 
              a.Status === 'Suspended' ? 'danger' : 'secondary' 
            %>">
              <%= a.Status %>
            </span>
          </td>
          <td>
            <% if (a.Teams && a.Teams.length > 0) { %>
              <% a.Teams.split(',').forEach(team => { %>
                <span class="badge bg-info text-dark mb-1"><%= team.trim() %></span>
              <% }) %>
            <% } else { %>
              <span class="text-muted">None</span>
            <% } %>
          </td>
          <td><%= a.MedicalHistory ? a.MedicalHistory : 'None' %></td>
          <td>
            <a href="/studentAthlete/edit/<%= a.StudentID %>" class="btn btn-warning btn-sm">Edit</a>
           <form action="/studentAthlete/delete/<%= a.StudentID %>" 
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this student athlete? This action cannot be undone.');">
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../partials/footer") %>

