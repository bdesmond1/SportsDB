<%- include("../partials/header") %>

<div class="container mt-5">
  <a href="/studentAthlete" class="btn btn-secondary mb-3">← Back</a>
  <h2><%= title %></h2>

  <form action="/studentAthlete/edit/<%= athlete.StudentID %>" method="POST">
    <div class="mb-3">
      <label for="Name" class="form-label">Name</label>
      <input type="text" name="Name" id="Name" class="form-control" value="<%= athlete.Name %>" required>
    </div>

    <div class="mb-3">
      <label for="DOB" class="form-label">DOB</label>
      <input type="date" name="DOB" id="DOB" class="form-control" value="<%= athlete.DOB.toISOString().split('T')[0] %>" required>
    </div>

    <div class="mb-3">
      <label for="Status" class="form-label">Status</label>
      <select name="Status" id="Status" class="form-select" required>
        <option value="Active" <%= athlete.Status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= athlete.Status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        <option value="Suspended" <%= athlete.Status === 'Suspended' ? 'selected' : '' %>>Suspended</option>
        <option value="Injured" <%= athlete.Status === 'Injured' ? 'selected' : '' %>>Injured</option>
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label">Teams</label>
      <div id="team-container">
        <% if (athlete.Teams && athlete.Teams.length) { %>
          <% athlete.Teams.forEach(team => { %>
            <div class="input-group mb-2 team-select">
              <select name="Teams[]" class="form-select" required>
                <option value="">-- Select Team --</option>
                <%- teamOptions.replace(new RegExp('value="' + team + '"'), 'value="' + team + '" selected') %>
              </select>
              <button type="button" class="btn btn-outline-danger" onclick="this.parentNode.remove()">Remove</button>
            </div>
          <% }) %>
        <% } else { %>
          <div class="input-group mb-2 team-select">
            <select name="Teams[]" class="form-select" required>
              <option value="">-- Select Team --</option>
              <%- teamOptions %>
            </select>
            <button type="button" class="btn btn-outline-primary" onclick="addTeam()">+ Add Another Team</button>
          </div>
        <% } %>
      </div>
      <button type="button" class="btn btn-outline-primary mt-2" onclick="addTeam()">+ Add Another Team</button>
    </div>

    <div class="mb-3">
      <label for="MedicalHistory" class="form-label">Medical History</label>
      <textarea name="MedicalHistory" id="MedicalHistory" class="form-control"><%= athlete.MedicalHistory %></textarea>
    </div>

    <button class="btn btn-success">Save Changes</button>
  </form>
</div>

<!-- hidden template for cloning -->
<div id="team-template" style="display:none;">
  <div class="input-group mb-2 team-select">
    <select name="Teams[]" class="form-select" required>
      <option value="">-- Select Team --</option>
      <%- teamOptions %>
    </select>
    <button type="button" class="btn btn-outline-danger" onclick="this.parentNode.remove()">Remove</button>
  </div>
</div>

<script>
  function addTeam() {
    const container = document.getElementById('team-container');
    const template = document.getElementById('team-template');
    const clone = template.firstElementChild.cloneNode(true);
    clone.style.display = '';
    container.appendChild(clone);
  }
</script>

<%- include("../partials/footer") %>

