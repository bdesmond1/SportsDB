<%- include('../partials/header') %>
<title><%= title %></title>
</head>
<body>
<div class="container mt-5">
    <a href="/teams" class="btn btn-secondary mb-3">← Back to Team List</a>
    <h2>Edit Team: <%= team.TeamName %></h2>

    <form action="/teams/edit/<%= team.TeamName %>" method="POST">
        <div class="mb-3">
            <label for="sport" class="form-label">Sport</label>
            <input type="text" id="sport" name="sport" class="form-control" value="<%= team.Sport %>" required>
        </div>

        <div class="mb-3">
            <label for="gender" class="form-label">Gender</label>
            <select id="gender" name="gender" class="form-select" required>
                <option value="">-- Select Gender --</option>
                <option value="Male" <%= team.Gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= team.Gender === 'Female' ? 'selected' : '' %>>Female</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="seasonStart" class="form-label">Season Start</label>
            <input type="date" id="seasonStart" name="seasonStart" class="form-control" 
                   value="<%= team.SeasonStart ? new Date(team.SeasonStart).toISOString().slice(0,10) : '' %>">
        </div>

        <div class="mb-3">
            <label for="seasonEnd" class="form-label">Season End</label>
            <input type="date" id="seasonEnd" name="seasonEnd" class="form-control" 
                   value="<%= team.SeasonEnd ? new Date(team.SeasonEnd).toISOString().slice(0,10) : '' %>">
        </div>

        <div class="mb-3">
            <label for="coachId" class="form-label">Assign Coach (Optional)</label>
            <select id="coachId" name="coachId" class="form-select">
                <option value="">-- Select Coach --</option>
                <% coaches.forEach(coach => { %>
                    <option value="<%= coach.StaffID %>" <%= team.StaffID === coach.StaffID ? 'selected' : '' %>>
                        <%= coach.Name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Update Team</button>
    </form>
</div>
<%- include('../partials/footer') %>
