<%- include('../partials/header', { title }) %>

<div class="container mt-5">
    <h1 class="mb-4"><%= title %></h1>

    <!-- Athlete dropdown (only for /teammates) -->
    <% if (athletes && athletes.length > 0) { %>
        <form action="/teams/dashboard/teammates" method="GET" class="row g-3 align-items-center mb-4">
            <div class="col-md-6">
                <select name="athleteName" class="form-select">
                    <option disabled selected>Select athlete...</option>
                    <% athletes.forEach(a => { %>
                        <option value="<%= a.Name %>" <%= selectedAthlete === a.Name ? 'selected' : '' %>><%= a.Name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary">View Teammates</button>
            </div>
        </form>
    <% } %>

    <!-- Teammates table -->
    <% if (results && results.length > 0 && results[0].DOB) { %>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Teammate Name</th>
                    <th>Team Name</th>
                    <th>Date of Birth</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach(row => { %>
                    <tr>
                        <td><%= row.TeammateName || 'N/A' %></td>
                        <td><%= row.TeamName || 'N/A' %></td>
                        <td><%= row.DOB ? new Date(row.DOB).toLocaleDateString('en-US') : 'N/A' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>

<!-- Active Teams table -->
<% if (results && results.length > 0 && results[0].SeasonStart) { %>
    <!-- Season banner -->
    <div class="alert alert-primary">
        Current Season: 
        <% 
            const month = new Date(results[0].SeasonStart).getMonth() + 1;
            let season = 'Fall';
            if ([12,1,2].includes(month)) season = 'Winter';
            else if ([3,4,5].includes(month)) season = 'Spring';
        %>
        <strong><%= season %></strong>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Team Name</th>
                <th>Sport</th>
                <th>Coach</th>
                <th>Season Start</th>
                <th>Season End</th>
            </tr>
        </thead>
        <tbody>
            <% results.forEach(team => { %>
                <tr>
                    <td><%= team.TeamName || 'N/A' %></td>
                    <td><%= team.Sport || 'N/A' %></td>
                    <td><%= team.CoachName || 'no assigned coach' %></td>
                    <td><%= team.SeasonStart ? new Date(team.SeasonStart).toLocaleDateString('en-US') : 'N/A' %></td>
                    <td><%= team.SeasonEnd ? new Date(team.SeasonEnd).toLocaleDateString('en-US') : 'N/A' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<!-- Teams grouped by season -->
<% if (teamsBySeason && teamsBySeason.length > 0) { %>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Season</th>
                <th>Sports</th>
            </tr>
        </thead>
        <tbody>
            <% teamsBySeason.forEach(row => { %>
                <tr>
                    <td><%= row.Season %></td>
                    <td>
                        <%= row.Sports
                            .split(',')
                            .map(sport => sport.trim())
                            .join(', ') %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>
    <div class="mt-3">
        <a href="/teams/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
<%- include('../partials/footer') %>
