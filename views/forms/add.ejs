<%- include('../partials/header', { title: 'Add Participation Form' }) %>

<div class="container mt-5">
  <div class="mb-4 d-flex gap-2">
    <a href="/" class="btn btn-secondary">Home</a>
    <button onclick="history.back()" class="btn btn-outline-secondary">← Back</button>
  </div>

  <h2 class="mb-4 text-center">Add New Participation Form</h2>

  <div class="card shadow-sm p-4">

    <form action="<%= student ? '/forms/add/' + student.StudentID : '/forms/add' %>" 
          method="POST" enctype="multipart/form-data">

      <!-- STUDENT FIELD -->
      <% if (student) { %>
        <div class="mb-3">
          <label class="form-label fw-bold">Student</label>
          <input type="text" class="form-control" value="<%= student.Name %>" readonly>
          <input type="hidden" name="StudentID" value="<%= student.StudentID %>">
        </div>
      <% } else { %>
        <div class="mb-3">
          <label class="form-label fw-bold">Student</label>
          <select name="StudentID" class="form-select" required>
            <option value="">-- Select Student --</option>
            <% students.forEach(s => { %>
              <option value="<%= s.StudentID %>"><%= s.Name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <!-- FORM TYPE -->
      <div class="mb-3">
        <label class="form-label fw-bold">Form Type</label>
        <select name="FormType" class="form-select" required>
          <option value="">-- Select Form Type --</option>
          <% ['Medical','Consent','Insurance','Physical','Travel'].forEach(t => { %>
            <option value="<%= t %>"><%= t %></option>
          <% }) %>
        </select>
      </div>

      <!-- VALID FROM -->
      <div class="mb-3">
        <label class="form-label fw-bold">Valid From</label>
        <input name="ValidFrom" type="date" class="form-control" required>
      </div>

      <!-- VALID TO -->
      <div class="mb-3">
        <label class="form-label fw-bold">Valid To</label>
        <input name="ValidTo" type="date" class="form-control" required>
      </div>

      <!-- FILE UPLOAD -->
      <div class="mb-3">
        <label class="form-label fw-bold">Upload File</label>
        <input type="file" name="FormFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
      </div>

      <!-- SUBMIT BUTTON -->
      <div class="d-flex justify-content-center">
        <button class="btn btn-primary px-5">Add Form</button>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>
