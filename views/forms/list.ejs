<%- include('../partials/header', { title: 'Participation Forms' }) %>

<div class="container py-4">
  <h1 class="mb-4">Participation Forms</h1>

  <% if (student) { %>
    <a href="/studentAthlete/list" class="btn btn-secondary mb-3">← Back to Athletes</a>
  <% } else { %>
    <a href="/" class="btn btn-secondary mb-3">Back to Home</a>
  <% } %>

  <form class="row g-2 mb-3" method="GET" action="/forms">
    <div class="col-md-4">
      <input name="q" value="<%= q || '' %>" class="form-control" placeholder="Search by student name or type">
    </div>
    <div class="col-md-2">
      <button class="btn btn-primary w-100">Search</button>
    </div>
    <div class="col-md-3"></div>
    <div class="col-md-3 text-end">
      <% if (student) { %>
        <a href="/forms/add/<%= student.StudentID %>" class="btn btn-success">Add New Form</a>
      <% } else { %>
        <a href="/forms/add" class="btn btn-success">Add New Form</a>
      <% } %>
    </div>
  </form>

  <table class="table table-bordered table-striped">
    <thead class="table-dark">
      <tr>
        <th>Form ID</th>
        <th>Student</th>
        <th>Type</th>
        <th>Valid From</th>
        <th>Valid To</th>
        <th>Status</th>
        <th>File</th>
        <th style="width: 200px;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (forms.length === 0) { %>
        <tr>
          <td colspan="8" class="text-center">No forms found.</td>
        </tr>
      <% } else { %>
        <% forms.forEach(f => { %>
          <tr>
            <td><%= f.FormID %></td>
            <td><%= f.StudentName || 'Unknown' %></td>
            <td><%= f.FormType %></td>
            <td><%= f.ValidFrom ? new Date(f.ValidFrom).toLocaleDateString() : '' %></td>
            <td><%= f.ValidTo ? new Date(f.ValidTo).toLocaleDateString() : '' %></td>
            <td>
              <% 
                let badgeClass = 'secondary';
                if(f.Status === 'Approved') badgeClass = 'success';
                else if(f.Status === 'Pending') badgeClass = 'warning';
                else if(f.Status === 'Expired') badgeClass = 'danger';
              %>
              <span class="badge bg-<%= badgeClass %>"><%= f.Status %></span>
            </td>
            <td>
              <% if(f.FilePath) { %>
                <a href="<%= f.FilePath %>" target="_blank">View</a>
              <% } else { %>
                -
              <% } %>
            </td>
            <td>
              <a href="/forms/edit/<%= f.FormID %>" class="btn btn-warning btn-sm">Edit</a>
              <form action="/forms/delete/<%= f.FormID %>" method="POST" class="d-inline">
                <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this form?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>

