<%- include('../partials/header', { title }) %>

<div class="container mt-5">
  <h1 class="mb-4"><%= title %></h1>

  <% if (typeof areas !== 'undefined' && areas.length > 0) { %>
    <form action="/sessions/dashboard/byArea" method="POST" class="mb-4">
      <div class="row g-2 align-items-center">
        <div class="col-auto">
          <label for="areaName" class="form-label">Select Area:</label>
        </div>
        <div class="col-auto">
          <select name="areaName" id="areaName" class="form-select" required>
            <% areas.forEach(function(area) { %>
              <option value="<%= area.AreaName %>"><%= area.AreaName %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-primary">Query</button>
        </div>
      </div>
    </form>
  <% } %>

  <% if (!results || results.length === 0) { %>
    <p>No results found.</p>
  <% } else { %>
    <table class="table table-striped table-bordered">
      <thead class="table-dark">
        <tr>
          <% Object.keys(results[0]).forEach(function(key) { %>
            <th>
              <%= key
                    .replace(/_/g, ' ')
                    .replace(/([a-z])([A-Z])/g, '$1 $2')
                    .replace(/^./, function(str){ return str.toUpperCase(); }) %>
            </th>
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% results.forEach(function(row) { %>
          <tr>
            <% Object.keys(row).forEach(function(key) { %>
              <td>
                <% 
                  let value = row[key];
                  if (value === null || value === '') { 
                %>
                    <span class="text-muted">None</span>
                <% 
                  } else {
                    // Format date
                    if (key.toLowerCase().includes('date')) {
                      let d = new Date(value);
                      value = `${('0'+(d.getMonth()+1)).slice(-2)}/${('0'+d.getDate()).slice(-2)}/${d.getFullYear()}`;
                    }
                    // Format time
                    else if (key.toLowerCase().includes('time')) {
                      let t = new Date('1970-01-01T'+value+'Z');
                      let hours = t.getUTCHours();
                      let minutes = ('0'+t.getUTCMinutes()).slice(-2);
                      let ampm = hours >= 12 ? 'PM' : 'AM';
                      hours = hours % 12;
                      hours = hours ? hours : 12;
                      value = `${hours}:${minutes} ${ampm}`;
                    }
                %>
                    <%= value %>
                <% } %>
              </td>
            <% }); %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <div class="mt-3">
    <a href="/sessions/dashboard" class="btn btn-secondary">Back to Dashboard</a>
  </div>
</div>

<%- include('../partials/footer') %>
