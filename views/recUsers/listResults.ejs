<%- include('../partials/header', { title }) %>

<div class="container mt-5">
    <h1 class="mb-4"><%= title %></h1>

    <!-- Session dropdown (optional) -->
    <% if (typeof sessions !== 'undefined' && sessions.length > 0) { %>
        <form action="/recusers/dashboard/attendance" method="GET" class="row g-3 align-items-center mb-4">
            <div class="col-auto">
                <label for="session_id" class="col-form-label">Select Session:</label>
            </div>
            <div class="col-auto">
                <select name="session_id" id="session_id" class="form-select">
                    <option value="">-- Choose Session --</option>
                    <% sessions.forEach(session => { %>
                        <option value="<%= session.SessionID %>" <%= selectedSessionId == session.SessionID ? 'selected' : '' %>>
                            <%= session.SessionDetails %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">View Attendance</button>
            </div>
        </form>
    <% } %>

    <!-- Session details (optional) -->
    <% if (typeof details !== 'undefined' && details) { %>
        <%
            const sessionDate = new Date(details.Date);
            const formattedDate = sessionDate.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

            const formatTime = (timeStr) => {
                if (!timeStr) return '';
                const [hours, minutes, seconds] = timeStr.split(':');
                const dateObj = new Date();
                dateObj.setHours(hours, minutes, seconds || 0);
                return dateObj.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
            };
        %>
        <p>
            <strong>Session Details:</strong>
            Date: <%= formattedDate %>,
            Start: <%= formatTime(details.StartTime) %>,
            End: <%= formatTime(details.EndTime) %>,
            Type: <%= details.Type %>
        </p>
    <% } %>

    <!-- Results table -->
    <% if (!results || results.length === 0) { %>
        <p>No results found.</p>
    <% } else { %>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <% Object.keys(results[0]).forEach(function(key) { %>
                        <th>
                            <%= key
                                .replace(/_/g, ' ')
                                .replace(/([a-z])([A-Z])/g, '$1 $2')
                                .replace(/^./, str => str.toUpperCase()) %>
                        </th>
                    <% }); %>
                </tr>
            </thead>
            <tbody>
                <% results.forEach(function(row) { %>
                    <tr>
                        <% Object.keys(row).forEach(function(key) { %>
                            <td>
                                <%
                                    let value = row[key];
                                    if (key === 'Date' && value) {
                                        const d = new Date(value);
                                        value = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
                                    } else if ((key === 'StartTime' || key === 'EndTime') && value) {
                                        const [hours, minutes, seconds] = value.split(':');
                                        const dateObj = new Date();
                                        dateObj.setHours(hours, minutes, seconds || 0);
                                        value = dateObj.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                    }
                                %>
                                <% if (!value || value === '') { %>
                                    <span class="text-muted">None</span>
                                <% } else { %>
                                    <%= value %>
                                <% } %>
                            </td>
                        <% }); %>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>

    <div class="mt-3">
        <a href="/recusers/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>

<%- include('../partials/footer') %>
