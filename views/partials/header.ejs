<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "College Sports Facility" %></title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand" href="/">College Sports Facility</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/studentAthlete/dashboard">Student Athletes</a></li>
        <li class="nav-item"><a class="nav-link" href="/recusers/dashboard">Rec Users</a></li>
        <li class="nav-item"><a class="nav-link" href="/sportsArea/dashboard">Sports Areas</a></li>
        <li class="nav-item"><a class="nav-link" href="/sessions/dashboard">Sessions</a></li>
        <li class="nav-item"><a class="nav-link" href="/staff/dashboard">Staff</a></li>
        <li class="nav-item"><a class="nav-link" href="/forms">Forms</a></li>
        <li class="nav-item"><a class="nav-link" href="/teams/dashboard">Teams</a></li>
      </ul>
    </div>
  </div>
</nav>
<div class="container mt-4">
  <% const msg = (typeof message !== 'undefined' && message) ? message : null; %>
<% if (msg && msg.trim()) { %>
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% const err = (typeof error !== 'undefined' && error) ? error : null; %>
<% if (err && err.trim()) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= err %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
</div>