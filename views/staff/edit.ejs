<%- include("../partials/header") %>

<div class="container mt-5">
  <a href="/staff" class="btn btn-secondary mb-3">← Back</a>
  <h2><%= title %></h2>

  <form action="/staff/edit/<%= staff.StaffID %>" method="POST">
    <div class="mb-3">
      <label for="Name" class="form-label">Name</label>
      <input type="text" name="Name" id="Name" class="form-control" value="<%= staff.Name %>" required>
    </div>

    <div class="mb-3">
      <label for="Type" class="form-label">Type</label>
      <select name="Type" id="Type" class="form-select" required>
        <option value="Coach" <%= staff.Type === 'Coach' ? 'selected' : '' %>>Coach</option>
        <option value="Trainer" <%= staff.Type === 'Trainer' ? 'selected' : '' %>>Trainer</option>
      </select>
    </div>

    <div class="mb-3">
      <label for="Email" class="form-label">Email</label>
      <input type="email" name="Email" id="Email" class="form-control" value="<%= staff.Email %>">
    </div>

    <div class="mb-3">
      <label for="PhoneNum" class="form-label">Phone</label>
      <input type="text" name="PhoneNum" id="PhoneNum" class="form-control" value="<%= staff.PhoneNum %>">
    </div>

    <div class="mb-3">
      <label class="form-label">Teams</label>
      <div id="team-container">
        <% if (staffTeams && staffTeams.length) { %>
          <% staffTeams.forEach(team => { %>
            <div class="input-group mb-2 team-select">
              <select name="Teams[]" class="form-select" required>
                <option value="">-- Select Team --</option>
                <% allTeams.forEach(t => { %>
                  <option value="<%= t.TeamName %>" <%= t.TeamName === team ? 'selected' : '' %>><%= t.TeamName %></option>
                <% }) %>
              </select>
              <button type="button" class="btn btn-outline-danger" onclick="this.parentNode.remove()">Remove</button>
            </div>
          <% }) %>
        <% } else { %>
          <div class="input-group mb-2 team-select">
            <select name="Teams[]" class="form-select" required>
              <option value="">-- Select Team --</option>
              <% allTeams.forEach(t => { %>
                <option value="<%= t.TeamName %>"><%= t.TeamName %></option>
              <% }) %>
            </select>
            <button type="button" class="btn btn-outline-primary" onclick="addTeam()">+ Add Another Team</button>
          </div>
        <% } %>
      </div>
      <button type="button" class="btn btn-outline-primary mb-3" onclick="addTeam()">+ Add Another Team</button>
    </div>

    <button class="btn btn-success">Update Staff</button>
  </form>
</div>

<div id="team-template" style="display:none;">
  <div class="input-group mb-2 team-select">
    <select name="Teams[]" class="form-select" required>
      <option value="">-- Select Team --</option>
      <% allTeams.forEach(t => { %>
        <option value="<%= t.TeamName %>"><%= t.TeamName %></option>
      <% }) %>
    </select>
    <button type="button" class="btn btn-outline-danger" onclick="this.parentNode.remove()">Remove</button>
  </div>
</div>

<script>
function addTeam() {
    const container = document.getElementById('team-container');
    const template = document.getElementById('team-template');
    const clone = template.firstElementChild.cloneNode(true);
    clone.style.display = '';
    container.appendChild(clone);
}
</script>

<%- include("../partials/footer") %>
