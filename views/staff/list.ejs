<%- include("../partials/header") %>

<div class="container mt-5">
  <a href="/staff/dashboard" class="btn btn-secondary mb-3">← Back to Dashboard</a>
  <h2><%= title %></h2>

  <a href="/staff/add" class="btn btn-primary mb-3">Add Staff</a>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Teams</th>
        <th>Type</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% staff.forEach(s => { %>
        <tr>
          <td><%= s.StaffID %></td>
          <td><%= s.Name %></td>
          <td>
            <% 
              const teams = Array.isArray(s.Teams) 
                            ? s.Teams 
                            : (s.Teams ? s.Teams.split(',') : []); 
            %>
            <% if (teams.length) { %>
              <% teams.forEach(team => { %>
                <span class="badge bg-info text-dark mb-1"><%= team.trim() %></span>
              <% }) %>
            <% } else { %>
              <span class="text-muted">No Teams</span>
            <% } %>
          </td>
          <td><%= s.Type %></td>
          <td><%= s.Email %></td>
          <td><%= s.PhoneNum %></td>
          <td>
            <a href="/staff/edit/<%= s.StaffID %>" class="btn btn-warning btn-sm">Edit</a>
            <form action="/staff/delete/<%= s.StaffID %>" method="POST" style="display:inline">
              <button class="btn btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../partials/footer") %>
